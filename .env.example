# Supabase: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# WhatsApp number of the KirayaSaathi team (country code, no plus). Used on the login and Plans screens.
EXPO_PUBLIC_SUPPORT_WHATSAPP=91XXXXXXXXXX

# Your website address (no slash at the end). The Plans screen opens WEBSITE/pay?t=... where Razorpay takes the payment.
EXPO_PUBLIC_WEBSITE_URL=https://kirayasaathi.in

# Old test login by phone (turned off). Leave empty.
EXPO_PUBLIC_TEST_PHONE=


# Google Maps JavaScript API key (map pin screen). Google Cloud Console > APIs & Services > enable "Maps JavaScript API".
# Restrict it: HTTP referrers = https://kirayasaathi.in/*  and API restriction = Maps JavaScript API.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
